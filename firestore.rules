rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'password')
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }
    match /players/{id} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.name.size() <= 40
                   && request.resource.data.photo.size() <= 120000;
      allow delete: if isAdmin();
    }
    match /tournaments/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /matches/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /champions/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /notices/{id}      { allow read: if true; allow write: if isAdmin(); }
  }
}
